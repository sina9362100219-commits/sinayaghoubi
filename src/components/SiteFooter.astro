---
import { ArrowUp } from '@lucide/astro';
import { navigation, siteConfig } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-intro">
      <span class="eyebrow">SINA YAGHOUB</span>
      <a class="footer-brand" href="/">
        <strong>{siteConfig.title}</strong>
        <span>{siteConfig.introduction}</span>
      </a>
    </div>
    <nav class="footer-links" aria-label="پیوندهای اصلی">
      <span>مطالعه</span>
      {navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a class="footer-back-top" href="#top">
        بازگشت به بالا <ArrowUp size={15} aria-hidden="true" />
      </a>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>
      © {year} {siteConfig.name}
    </span>
    <span class="footer-credit">
      بر پایهٔ <a href="https://github.com/saicaca/fuwari">Fuwari</a> و Astro
    </span>
  </div>
</footer>
