---
const navigation = [
  { label: 'صفحهٔ اصلی', href: '/' },
  { label: 'روانکاوی', href: '/psychoanalysis/' },
  { label: 'فلسفه', href: '/philosophy/' },
];
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="footer-brand-link" href="/">
        <span class="footer-mark" aria-hidden="true">
          س
        </span>
        <span class="footer-brand-copy">
          <strong>روانکاوی با سینا</strong>
          <small>روانکاوی و فلسفه</small>
        </span>
      </a>
      <p>فضایی برای مطالعه و تأمل دربارهٔ ذهن، انسان و پرسش‌های بنیادین زندگی.</p>
    </div>

    <nav class="footer-nav" aria-label="پیوندهای اصلی">
      <h2 class="footer-label">بخش‌های سایت</h2>
      {navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="footer-note">
      <h2 class="footer-label">مطالعه و تأمل</h2>
      <p>فهمیدن، گاهی از بهتر پرسیدن آغاز می‌شود.</p>
      <a class="back-to-top" href="#top">
        بازگشت به بالای صفحه <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© {new Date().getFullYear()} روانکاوی با سینا</span>
      <span>برای اندیشیدن، خواندن و گفت‌وگو</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 2px solid var(--sina-teal-deep);
    background: var(--sina-white);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(150px, 0.7fr) minmax(220px, 0.9fr);
    gap: var(--space-12);
    padding-block: var(--space-12);
  }

  .footer-brand {
    max-inline-size: 390px;
  }

  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-mark {
    display: grid;
    inline-size: 44px;
    block-size: 44px;
    place-items: center;
    border: 1px solid var(--sina-border);
    color: var(--sina-teal-deep);
    font-family: var(--font-literary);
    font-size: 30px;
    line-height: 1;
  }

  .footer-brand-copy {
    display: grid;
    line-height: 1.65;
  }

  .footer-brand-copy strong {
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .footer-brand-copy small {
    color: var(--sina-muted);
    font-size: var(--text-xs);
  }

  .footer-brand p,
  .footer-note p {
    max-inline-size: 360px;
    margin: var(--space-4) 0 0;
    color: var(--sina-muted);
    font-size: var(--text-sm);
    line-height: 2;
  }

  .footer-nav,
  .footer-note {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-label {
    margin: 0 0 var(--space-3);
    color: var(--sina-charcoal);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .footer-nav a,
  .back-to-top {
    display: inline-flex;
    min-block-size: 40px;
    align-items: center;
    color: var(--sina-muted);
    font-size: var(--text-sm);
    transition: color 160ms ease;
  }

  .footer-nav a:hover,
  .back-to-top:hover {
    color: var(--sina-teal-deep);
  }

  .footer-note p {
    margin-block: 0 var(--space-2);
  }

  .back-to-top {
    gap: var(--space-2);
  }

  .back-to-top span {
    color: var(--sina-ruby);
    font-size: 1.125rem;
  }

  .footer-bottom {
    border-block-start: 1px solid var(--sina-border);
  }

  .footer-bottom-inner {
    display: flex;
    min-block-size: 56px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--sina-muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 760px) {
    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-6);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-block: var(--space-8);
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-bottom-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 0;
      padding-block: var(--space-3);
    }
  }
</style>
