---
const navigation = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'روانکاوی', href: '/psychoanalysis/' },
  { label: 'فلسفه', href: '/philosophy/' },
];
---

<footer class="site-footer">
  <div class="footer-decoration" aria-hidden="true">
    <span>ر</span>
    <span>ف</span>
  </div>

  <div class="container footer-main">
    <div class="footer-brand">
      <a class="footer-brand-link" href="/">
        <span class="footer-mark" aria-hidden="true">س</span>
        <span class="footer-brand-copy">
          <strong>روانکاوی با سینا</strong>
          <small>روانکاوی و فلسفه</small>
        </span>
      </a>
      <p>
        فضایی برای مطالعه و تأمل درباره ذهن، انسان و پرسش‌های بنیادین زندگی.
      </p>
    </div>

    <nav class="footer-nav" aria-label="پیوندهای اصلی">
      <span class="footer-label">بخش‌های سایت</span>
      {navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="footer-note">
      <span class="footer-label">مطالعه و تأمل</span>
      <p>فهمیدن، گاهی از بهتر پرسیدن آغاز می‌شود.</p>
      <a class="back-to-top" href="#top">
        بازگشت به بالای صفحه
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© {new Date().getFullYear()} روانکاوی با سینا</span>
      <span class="footer-bottom-note">برای اندیشیدن، خواندن و گفت‌وگو</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    padding-top: 66px;
    background:
      radial-gradient(ellipse at 87% 0%, rgba(53, 199, 189, .12), transparent 34%),
      linear-gradient(135deg, #203b3a, #263b3b 58%, #302f36);
    color: #f7f8f5;
  }

  .site-footer::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--sina-teal-light), var(--sina-ruby-light), transparent);
    content: '';
  }

  .footer-decoration {
    position: absolute;
    left: max(2%, calc((100vw - var(--container)) / 2));
    bottom: 56px;
    display: flex;
    align-items: center;
    gap: 5px;
    color: rgba(255, 255, 255, .035);
    font-family: var(--font-literary);
    font-size: clamp(100px, 18vw, 230px);
    line-height: .8;
    pointer-events: none;
    user-select: none;
  }

  .footer-main {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(260px, 1.4fr) minmax(150px, .7fr) minmax(220px, .9fr);
    gap: 70px;
    padding-bottom: 56px;
  }

  .footer-brand {
    max-width: 390px;
  }

  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 13px;
  }

  .footer-mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 16px 16px 16px 5px;
    background: rgba(255, 255, 255, .08);
    color: #a9e3d8;
    font-family: var(--font-literary);
    font-size: 31px;
    line-height: 1;
  }

  .footer-brand-copy {
    display: grid;
    gap: 2px;
    line-height: 1.6;
  }

  .footer-brand-copy strong {
    font-size: 16px;
    font-weight: 800;
  }

  .footer-brand-copy small {
    color: rgba(245, 248, 245, .58);
    font-size: 10px;
  }

  .footer-brand p {
    max-width: 340px;
    margin: 20px 0 0;
    color: rgba(245, 248, 245, .7);
    font-size: 13px;
    line-height: 2.2;
  }

  .footer-nav,
  .footer-note {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-label {
    margin-bottom: 17px;
    color: #a9e3d8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .03em;
  }

  .footer-nav a {
    margin-bottom: 9px;
    color: rgba(245, 248, 245, .72);
    font-size: 12px;
    transition: color .2s ease, transform .2s ease;
  }

  .footer-nav a:hover {
    transform: translateX(-3px);
    color: white;
  }

  .footer-note p {
    max-width: 250px;
    margin: 0 0 20px;
    color: rgba(245, 248, 245, .84);
    font-size: 15px;
    line-height: 2;
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: rgba(245, 248, 245, .66);
    font-size: 11px;
    transition: color .2s ease;
  }

  .back-to-top span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid rgba(255, 255, 255, .2);
    border-radius: 50%;
    color: #a9e3d8;
    font-size: 15px;
    transition: transform .2s ease, background .2s ease;
  }

  .back-to-top:hover {
    color: white;
  }

  .back-to-top:hover span {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, .08);
  }

  .footer-bottom {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255, 255, 255, .12);
  }

  .footer-bottom-inner {
    min-height: 64px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    color: rgba(245, 248, 245, .55);
    font-size: 10px;
  }

  .footer-brand-link:focus-visible,
  .footer-nav a:focus-visible,
  .back-to-top:focus-visible {
    outline: 3px solid rgba(169, 227, 216, .65);
    outline-offset: 4px;
  }

  @media (max-width: 800px) {
    .footer-main {
      grid-template-columns: minmax(0, 1.2fr) minmax(130px, .8fr);
      gap: 42px 28px;
    }

    .footer-note {
      grid-column: 2;
    }
  }

  @media (max-width: 560px) {
    .site-footer {
      padding-top: 48px;
    }

    .footer-main {
      grid-template-columns: 1fr;
      gap: 30px;
      padding-bottom: 38px;
    }

    .footer-note {
      grid-column: auto;
    }

    .footer-label {
      margin-bottom: 10px;
    }

    .footer-bottom-inner {
      min-height: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding-block: 14px;
    }
  }
</style>
