---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  entries: CollectionEntry<'content'>[];
}

const { entries } = Astro.props;
---

{entries.length > 0 ? (
  <div class="post-list" aria-label="فهرست مطالب">
    {entries.map((entry, index) => (
      <PostCard entry={entry} featured={index === 0} />
    ))}
  </div>
) : (
  <p class="archive-empty">مطالب این بخش به‌زودی منتشر خواهند شد.</p>
)}
