---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  entries: CollectionEntry<'content'>[];
}

const { entries } = Astro.props;
const revealTypes = ['diagonal', 'circle', 'curtain'] as const;
---

{entries.length > 0 ? (
  <div class="post-list" aria-label="فهرست مطالب">
    {entries.map((entry, index) => (
      <PostCard
        entry={entry}
        featured={index === 0}
        index={index}
        revealType={revealTypes[index % revealTypes.length]}
      />
    ))}
  </div>
) : (
  <p class="archive-empty">مطالب این بخش به‌زودی منتشر خواهند شد.</p>
)}
