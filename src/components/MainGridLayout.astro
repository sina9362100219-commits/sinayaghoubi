---
import { siteConfig } from '../config';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import Sidebar from './Sidebar.astro';
import Layout from '../layouts/Layout.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  socialImage?: string;
  socialImageAlt?: string;
  noIndex?: boolean;
  isHome?: boolean;
}

const {
  title,
  description,
  type = 'website',
  socialImage,
  socialImageAlt,
  noIndex = false,
  isHome = false,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  type={type}
  socialImage={socialImage}
  socialImageAlt={socialImageAlt}
  noIndex={noIndex}
>
  <div class="site-frame">
    <SiteHeader />
    <div class="site-banner" aria-hidden="true">
      <img
        src={siteConfig.banner}
        alt=""
        width="1200"
        height="900"
        loading={isHome ? 'eager' : 'lazy'}
        fetchpriority={isHome ? 'high' : 'auto'}
        decoding="async"
      />
      <div class="banner-caption">
        <strong>{siteConfig.title}</strong>
        <span lang="en">{siteConfig.subtitle}</span>
      </div>
    </div>
    <div class="main-grid">
      <Sidebar />
      <main id="main-content" class="main-column" tabindex="-1">
        <slot />
      </main>
    </div>
    <SiteFooter />
  </div>
</Layout>
