---
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import EditorialMotion from './EditorialMotion.astro';
import Layout from '../layouts/Layout.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  socialImage?: string;
  socialImageAlt?: string;
  noIndex?: boolean;
  isHome?: boolean;
}

const {
  title,
  description,
  type = 'website',
  socialImage,
  socialImageAlt,
  noIndex = false,
  isHome = false,
} = Astro.props;
const overHero = isHome || type === 'article';
---

<Layout
  title={title}
  description={description}
  type={type}
  socialImage={socialImage}
  socialImageAlt={socialImageAlt}
  noIndex={noIndex}
>
  <div class="site-frame">
    <SiteHeader overHero={overHero} />
    <main
      id="main-content"
      class:list={['main-column', { 'home-main': isHome, 'hero-main': overHero }]}
      tabindex="-1"
    >
      <slot />
    </main>
    <SiteFooter />
    <EditorialMotion />
  </div>
</Layout>
