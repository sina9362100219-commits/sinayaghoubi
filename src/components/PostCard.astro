---
import type { CollectionEntry } from 'astro:content';
import { estimateReadingMinutes } from '../lib/reading-time';

interface Props {
  entry: CollectionEntry<'content'>;
  featured?: boolean;
  index?: number;
  revealType?: 'circle' | 'diagonal' | 'curtain';
}

const { entry, featured = false, index = 0, revealType = 'diagonal' } = Astro.props;
const sectionTitle = entry.data.section === 'psychoanalysis' ? 'روانکاوی' : 'فلسفه';
const sectionUrl = entry.data.section === 'psychoanalysis' ? '/psychoanalysis/' : '/philosophy/';
const readingMinutes = estimateReadingMinutes(entry.body ?? '');
---

<article
  class:list={['post-card', { 'post-card--featured': featured }]}
  data-article-card
  data-filter-card
  data-article-section={entry.data.section}
  data-card-index={index}
  data-featured={featured ? 'true' : 'false'}
>
  {entry.data.cover ? (
    <a
      class="post-cover"
      href={`/materials/${entry.id}/`}
      aria-label={`خواندن: ${entry.data.title}`}
    >
      <span class:list={['image-reveal', `reveal-${revealType}`]}>
        <img
          src={entry.data.cover}
          alt=""
          width="1200"
          height="650"
          loading="lazy"
          decoding="async"
        />
      </span>
    </a>
  ) : (
    <span class="post-cover" aria-hidden="true"></span>
  )}
  <div class="post-copy">
    <div class="post-meta">
      <a class="post-section" data-section={entry.data.section} href={sectionUrl}>
        {sectionTitle}
      </a>
      {entry.data.publishedAt && (
        <time datetime={entry.data.publishedAt}>{entry.data.publishedAt}</time>
      )}
      <span>{readingMinutes} دقیقه مطالعه</span>
    </div>
    <h2 class="post-title">
      <a href={`/materials/${entry.id}/`} aria-label={entry.data.title}>
        <span data-scramble aria-hidden="true">
          {entry.data.title}
        </span>
      </a>
    </h2>
    <p class="post-description">{entry.data.description}</p>
    <div class="post-bottom">
      <div class="post-tags" aria-label="کلیدواژه‌ها">
        {entry.data.tags.slice(0, 3).map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
      <a class="read-link" href={`/materials/${entry.id}/`}>
        خواندن
        <span aria-hidden="true">←</span>
      </a>
    </div>
  </div>
</article>

<script>
  const revealItems = document.querySelectorAll<HTMLElement>('.image-reveal');
  const cards = document.querySelectorAll<HTMLElement>('[data-article-card]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
    cards.forEach((card) => card.classList.add('is-entered'));
  } else {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const target = entry.target as HTMLElement;
          target.classList.remove('is-pending');
          target.classList.add('is-visible');
          if (target.matches('[data-article-card]')) {
            target.classList.add('is-entered');
            target.animate(
              [
                { opacity: 0, transform: 'translateY(22px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              {
                duration: 620,
                delay: Number(target.dataset.cardIndex ?? 0) * 55,
                easing: 'cubic-bezier(.22,.7,.2,1)',
              },
            );
          }
          currentObserver.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );

    revealItems.forEach((item) => {
      item.classList.add('is-pending');
      observer.observe(item);
    });
    cards.forEach((card) => {
      if (card.getBoundingClientRect().top > window.innerHeight) {
        observer.observe(card);
      } else {
        card.classList.add('is-entered');
      }
    });
  }

  const canTilt = window.matchMedia('(hover: hover) and (pointer: fine)').matches && !reduceMotion;
  if (canTilt) {
    cards.forEach((card) => {
      const maxTilt = card.classList.contains('post-card--featured') ? 3.5 : 5;

      card.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        const bounds = card.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        card.style.setProperty('--tilt-x', `${-y * maxTilt}deg`);
        card.style.setProperty('--tilt-y', `${x * maxTilt}deg`);
        card.classList.add('is-tilting');
      });

      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--tilt-x', '0deg');
        card.style.setProperty('--tilt-y', '0deg');
        card.classList.remove('is-tilting');
      });
    });
  }

  const scrambleAlphabet = 'ابتثجحخدذرزسشصضطظعغفقكلمنهوي';
  const titleLinks = document.querySelectorAll<HTMLAnchorElement>('.post-title a');
  if (!reduceMotion) {
    titleLinks.forEach((link) => {
      const title = link.querySelector<HTMLElement>('[data-scramble]');
      if (!title) return;
      const original = title.textContent ?? '';
      let timeout: ReturnType<typeof setTimeout>;
      let interval: ReturnType<typeof setInterval>;

      const animateTitle = () => {
        clearTimeout(timeout);
        clearInterval(interval);
        const characters = Array.from(original);
        let frame = 0;
        interval = setInterval(() => {
          frame += 1;
          const progress = frame / 7;
          title.textContent = characters
            .map((character, characterIndex) => {
              if (!character.trim() || characterIndex / characters.length < progress) {
                return character;
              }
              return scrambleAlphabet[Math.floor(Math.random() * scrambleAlphabet.length)];
            })
            .join('');
          if (frame >= 7) {
            clearInterval(interval);
            title.textContent = original;
          }
        }, 32);
        timeout = setTimeout(() => {
          clearInterval(interval);
          title.textContent = original;
        }, 240);
      };

      link.addEventListener('pointerenter', animateTitle);
      link.addEventListener('focus', animateTitle);
      link.addEventListener('pointerleave', () => {
        clearTimeout(timeout);
        clearInterval(interval);
        title.textContent = original;
      });
      link.addEventListener('blur', () => {
        clearTimeout(timeout);
        clearInterval(interval);
        title.textContent = original;
      });
    });
  }
</script>
