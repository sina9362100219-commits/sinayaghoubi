---
const navigation = [
  { label: 'خانه', href: '/' },
  { label: 'روانکاوی', href: '/psychoanalysis/' },
  { label: 'فلسفه', href: '/philosophy/' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header id="top" class="site-header">
  <a class="skip-link" href="#main-content">
    رفتن به محتوای اصلی
  </a>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="روانکاوی با سینا، صفحهٔ اصلی">
      <span class="brand-mark" aria-hidden="true">
        <span>س</span>
        <i></i>
      </span>
      <span class="brand-copy">
        <strong>روانکاوی با سینا</strong>
        <small>روانکاوی و فلسفه</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="منوی اصلی">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <details class="mobile-menu">
      <summary aria-label="باز کردن منوی سایت">
        <span class="menu-lines" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </summary>
      <nav aria-label="منوی موبایل">
        {navigation.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    inset-block-start: 0;
    border-block-end: 1px solid var(--sina-border);
    background: rgba(255, 255, 255, 0.97);
  }

  .header-inner {
    display: flex;
    min-block-size: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-3);
  }

  .brand-mark {
    position: relative;
    display: grid;
    inline-size: 44px;
    block-size: 44px;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid rgba(0, 127, 128, 0.28);
    color: var(--sina-teal-deep);
  }

  .brand-mark > span {
    font-family: var(--font-literary);
    font-size: 30px;
    line-height: 1;
  }

  .brand-mark i {
    position: absolute;
    inset-block-start: 5px;
    inset-inline-start: 5px;
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: var(--sina-ruby);
  }

  .brand-copy {
    display: grid;
    line-height: 1.65;
  }

  .brand-copy strong {
    color: var(--sina-charcoal);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .brand-copy small {
    color: var(--sina-muted);
    font-size: var(--text-xs);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .desktop-nav a,
  .mobile-menu nav a {
    min-block-size: 44px;
    color: var(--sina-muted);
    font-size: var(--text-sm);
    transition: color 160ms ease;
  }

  .desktop-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .desktop-nav a::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 6px;
    block-size: 2px;
    transform: scaleX(0);
    transform-origin: right;
    background: var(--sina-teal-deep);
    content: '';
    transition: transform 160ms ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'],
  .mobile-menu nav a:hover,
  .mobile-menu nav a[aria-current='page'] {
    color: var(--sina-teal-deep);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 760px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      position: relative;
      display: block;
    }

    .mobile-menu summary {
      display: grid;
      inline-size: 44px;
      block-size: 44px;
      place-items: center;
      border: 1px solid var(--sina-border);
      background: var(--sina-white);
      cursor: pointer;
      list-style: none;
    }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .menu-lines {
      display: grid;
      gap: 5px;
    }

    .menu-lines span {
      inline-size: 18px;
      block-size: 2px;
      background: var(--sina-charcoal);
      transition: transform 160ms ease;
    }

    .mobile-menu[open] .menu-lines span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .mobile-menu[open] .menu-lines span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }

    .mobile-menu nav {
      position: absolute;
      inset-block-start: calc(100% + var(--space-2));
      inset-inline-end: 0;
      display: grid;
      min-inline-size: 190px;
      padding: var(--space-2);
      border: 1px solid var(--sina-border);
      background: var(--sina-white);
      box-shadow: var(--shadow-soft);
    }

    .mobile-menu nav a {
      display: flex;
      align-items: center;
      padding-inline: var(--space-3);
    }
  }

  @media (max-width: 360px) {
    .header-inner {
      gap: var(--space-3);
    }

    .brand-copy strong {
      font-size: 0.8125rem;
    }
  }
</style>
