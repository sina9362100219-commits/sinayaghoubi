---
const filters = [
  { id: 'all', label: 'همهٔ نوشته‌ها' },
  { id: 'psychoanalysis', label: 'روانکاوی' },
  { id: 'philosophy', label: 'فلسفه' },
];
---

<nav class="category-filter" aria-label="فیلتر نوشته‌ها" data-category-filter hidden>
  <div class="category-filter-track" role="group" aria-label="انتخاب بخش">
    <span class="category-filter-indicator" aria-hidden="true" data-filter-indicator></span>
    {filters.map((filter, index) => (
      <button
        type="button"
        data-filter={filter.id}
        aria-pressed={index === 0 ? 'true' : 'false'}
        aria-controls="latest-grid"
      >
        {filter.label}
      </button>
    ))}
  </div>
  <span class="visually-hidden" aria-live="polite" data-filter-status></span>
</nav>

<script>
  const filterNav = document.querySelector<HTMLElement>('[data-category-filter]');
  const filterTrack = filterNav?.querySelector<HTMLElement>('.category-filter-track');
  const filterButtons = Array.from(
    filterNav?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? [],
  );
  const filterIndicator = filterNav?.querySelector<HTMLElement>('[data-filter-indicator]');
  const filterStatus = filterNav?.querySelector<HTMLElement>('[data-filter-status]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-card]'));
  const reduceFilterMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let filterSequence = 0;

  function moveIndicator(button: HTMLButtonElement) {
    if (!filterTrack || !filterIndicator) return;
    const right = filterTrack.clientWidth - button.offsetLeft - button.offsetWidth;
    filterIndicator.style.width = `${button.offsetWidth}px`;
    filterIndicator.style.transform = `translateX(-${right}px)`;
  }

  function selectFilter(button: HTMLButtonElement) {
    const sequence = ++filterSequence;
    const section = button.dataset.filter ?? 'all';
    const visibleCards = cards.filter(
      (card) => section === 'all' || card.dataset.articleSection === section,
    );

    filterButtons.forEach((candidate) => {
      candidate.setAttribute('aria-pressed', String(candidate === button));
    });
    moveIndicator(button);

    for (const card of cards) {
      const shouldShow = visibleCards.includes(card);
      card.getAnimations().forEach((animation) => animation.cancel());
      const shouldFeature =
        section === 'all' ? card.dataset.featured === 'true' : card === visibleCards[0];
      card.classList.toggle('post-card--featured', shouldFeature);

      if (shouldShow) {
        const wasHidden = card.hidden;
        card.hidden = false;
        if (wasHidden && !reduceFilterMotion) {
          card.animate(
            [
              { opacity: 0, transform: 'translateY(14px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 300, easing: 'cubic-bezier(.2,.7,.2,1)' },
          );
        }
      } else if (!card.hidden) {
        if (reduceFilterMotion) {
          card.hidden = true;
        } else {
          const animation = card.animate(
            [
              { opacity: 1, transform: 'translateY(0)' },
              { opacity: 0, transform: 'translateY(-8px)' },
            ],
            { duration: 220, easing: 'ease-out' },
          );
          void animation.finished.then(() => {
            if (sequence === filterSequence) card.hidden = true;
          });
        }
      }
    }

    if (filterStatus) {
      filterStatus.textContent = `${visibleCards.length} نوشته نمایش داده شد.`;
    }
  }

  if (filterNav && filterButtons.length > 0) {
    filterNav.hidden = false;
    moveIndicator(filterButtons[0]);
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => selectFilter(button));
    });
    window.addEventListener('resize', () => {
      const active = filterButtons.find((button) => button.getAttribute('aria-pressed') === 'true');
      if (active) moveIndicator(active);
    });
  }
</script>
