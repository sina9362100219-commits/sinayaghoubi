<script>
  const wordHeadings = document.querySelectorAll<HTMLElement>('[data-word-reveal]');
  const pullQuotes = document.querySelectorAll<HTMLElement>('[data-quote-reveal]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if ('IntersectionObserver' in window && !reduceMotion) {
    const observer = new IntersectionObserver(
      (entries, currentObserver) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          currentObserver.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );

    wordHeadings.forEach((heading) => {
      const text = heading.textContent?.trim();
      if (!text) return;
      heading.setAttribute('aria-label', text);
      heading.replaceChildren(
        ...text.split(/(\s+)/u).map((part, index) => {
          if (/^\s+$/u.test(part)) return document.createTextNode(part);
          const word = document.createElement('span');
          word.className = 'kinetic-word';
          word.style.setProperty('--word-index', String(index));
          word.textContent = part;
          word.setAttribute('aria-hidden', 'true');
          return word;
        }),
      );
      heading.classList.add('word-reveal-ready');
      observer.observe(heading);
    });

    pullQuotes.forEach((quote) => observer.observe(quote));
  } else {
    wordHeadings.forEach((heading) => heading.classList.add('is-visible'));
    pullQuotes.forEach((quote) => quote.classList.add('is-visible'));
  }
</script>
