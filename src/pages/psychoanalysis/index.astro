---
import { getCollection } from 'astro:content';
import MaterialArchive from '../../components/MaterialArchive.astro';
import MainGridLayout from '../../components/MainGridLayout.astro';

const entries = await getCollection(
  'content',
  ({ data }) => data.section === 'psychoanalysis' && !data.draft,
);

entries.sort((a, b) => (b.data.publishedAt ?? '').localeCompare(a.data.publishedAt ?? ''));
---

<MainGridLayout
  title="روانکاوی | روانکاوی با سینا"
  description="مطالعهٔ نظریه‌ها، مفاهیم، متون و پرسش‌های روانکاوانه."
>
  <section class="section-page" aria-labelledby="archive-title">
    <header class="page-heading">
      <span class="eyebrow">01 / PSYCHOANALYSIS</span>
      <h1 id="archive-title" data-word-reveal>
        روانکاوی
      </h1>
      <p>مطالعهٔ نظریه‌ها، مفاهیم، متون و پرسش‌های روانکاوانه.</p>
    </header>
    <MaterialArchive entries={entries} />
  </section>
</MainGridLayout>
