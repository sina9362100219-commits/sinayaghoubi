---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entries = await getCollection(
  'content',
  ({ data }) => data.section === 'psychoanalysis' && !data.draft
);

entries.sort((a, b) =>
  (b.data.publishedAt ?? '').localeCompare(a.data.publishedAt ?? '')
);
---

<Layout title="روانکاوی | روانکاوی با سینا" description="مطالعه نظریه‌ها، مفاهیم، متون و پرسش‌های روانکاوانه.">
  <section class="section-page">
    <div class="container">
      <div class="page-heading">
        <span class="eyebrow">PSYCHOANALYSIS</span>
        <h1>روانکاوی</h1>
        <p>مطالعه نظریه‌ها، مفاهیم، متون و پرسش‌های روانکاوانه.</p>
      </div>

      {entries.length > 0 ? (
        <div class="entry-grid">
          {entries.map((entry) => (
            <a class="entry-card" href={`/materials/${entry.id}/`}>
              <span class="entry-date">{entry.data.publishedAt ?? ''}</span>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
              <span class="entry-link">مطالعه مطلب ←</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <span>—</span>
          <p>مطالب این بخش به‌زودی منتشر خواهند شد.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .section-page {
    min-height: 65vh;
    padding: 85px 0 110px;
    background: #FAFCFB;
  }

  .page-heading {
    padding-bottom: 35px;
    border-bottom: 1px solid var(--sina-border);
  }

  .page-heading h1 {
    margin: 18px 0 8px;
    font-size: clamp(35px, 5vw, 54px);
  }

  .page-heading p {
    color: var(--sina-muted);
    font-size: 14px;
    line-height: 2;
  }

  .entry-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 35px;
  }

  .entry-card {
    padding: 27px;
    background: white;
    border: 1px solid var(--sina-border);
    border-radius: 14px;
    transition: .2s ease;
  }

  .entry-card:hover {
    transform: translateY(-4px);
    border-color: var(--sina-teal);
    box-shadow: var(--shadow-soft);
  }

  .entry-date {
    color: #929C99;
    font-size: 11px;
  }

  .entry-card h2 {
    margin: 16px 0 8px;
    font-size: 21px;
  }

  .entry-card p {
    color: var(--sina-muted);
    font-size: 13px;
    line-height: 2;
  }

  .entry-link {
    display: inline-block;
    margin-top: 15px;
    color: var(--sina-ruby);
    font-size: 12px;
  }

  .empty-state {
    padding: 65px 15px;
    text-align: center;
    color: var(--sina-muted);
  }

  .empty-state span {
    color: var(--sina-teal);
    font-size: 30px;
  }

  @media(max-width: 650px) {
    .entry-grid { grid-template-columns: 1fr; }
    .section-page { padding-top: 60px; }
  }
</style>