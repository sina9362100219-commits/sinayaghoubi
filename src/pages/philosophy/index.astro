---
import { getCollection } from 'astro:content';
import MaterialArchive from '../../components/MaterialArchive.astro';
import MainGridLayout from '../../components/MainGridLayout.astro';

const entries = await getCollection(
  'content',
  ({ data }) => data.section === 'philosophy' && !data.draft,
);

entries.sort((a, b) => (b.data.publishedAt ?? '').localeCompare(a.data.publishedAt ?? ''));
---

<MainGridLayout
  title="فلسفه | روانکاوی با سینا"
  description="جست‌وجو در اندیشه‌های فلسفی و پرسش‌های بنیادین انسان و جهان."
>
  <section class="section-page" aria-labelledby="archive-title">
    <header class="page-heading">
      <span class="eyebrow">02 / PHILOSOPHY</span>
      <h1 id="archive-title" data-word-reveal>
        فلسفه
      </h1>
      <p>جست‌وجو در اندیشه‌های فلسفی و پرسش‌های بنیادین انسان و جهان.</p>
    </header>
    <MaterialArchive entries={entries} />
  </section>
</MainGridLayout>
