---
import { getCollection } from 'astro:content';
import { ArrowDown, ArrowLeft } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';

const materials = await getCollection('content', ({ data }) => !data.draft);

function latestIn(section: string) {
  return materials
    .filter((entry) => entry.data.section === section)
    .sort((a, b) => {
      const dateA = a.data.publishedAt ? Date.parse(a.data.publishedAt) : 0;
      const dateB = b.data.publishedAt ? Date.parse(b.data.publishedAt) : 0;
      return dateB - dateA || b.id.localeCompare(a.id);
    })
    .slice(0, 3);
}

const psychoanalysisArticles = latestIn('psychoanalysis');
const philosophyArticles = latestIn('philosophy');

const formatIndex = (index: number) =>
  new Intl.NumberFormat('fa-IR', { minimumIntegerDigits: 2, useGrouping: false }).format(index + 1);
---

<Layout
  title="روانکاوی و فلسفه | سینا یعقوبی"
  description="فضایی برای مطالعه و تأمل در روانکاوی و فلسفه."
  socialImage="/images/hero/inner-landscape.svg"
  socialImageAlt="کره‌ای شفاف با نیم‌رخ انسانی، پلکانی رو به بالا و کتابی گشوده"
>
  <div class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-layout">
        <div class="hero-copy">
          <div class="eyebrow">
            <span class="eyebrow-line" aria-hidden="true"></span>
            <span>روانکاوی و فلسفه</span>
            <span class="eyebrow-en" lang="en" dir="ltr">
              PSYCHE &amp; THOUGHT
            </span>
          </div>

          <h1 id="hero-title">
            در جست‌وجوی
            <span>معنای آنچه</span>
            <em>پنهان است.</em>
          </h1>

          <p class="hero-description">تأملی در روان، اندیشه و پیچیدگی تجربهٔ انسانی.</p>

          <a href="#explore" class="hero-link">
            <span class="link-icon" aria-hidden="true">
              <ArrowDown size={18} stroke-width={1.7} aria-hidden="true" />
            </span>
            <span>ورود به جهان اندیشه</span>
          </a>

          <div class="hero-index" aria-hidden="true">
            <span>۰۱</span>
            <span class="index-rule"></span>
            <span lang="en" dir="ltr">
              AN INQUIRY INTO THE HUMAN CONDITION
            </span>
          </div>
        </div>

        <figure class="art-stage">
          <img
            src="/images/hero/inner-landscape.svg"
            alt="کره‌ای شفاف که نیم‌رخ انسانی را در بر گرفته؛ پلکانی به سوی آن بالا می‌رود و کتابی باز در پیش‌زمینه قرار دارد."
            width="1200"
            height="900"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>
            <span lang="en" dir="ltr">
              FIG. 01
            </span>
            <span>منظرۀ درونی؛ تأملی بر امر نادیدنی</span>
          </figcaption>
        </figure>
      </div>

      <div class="hero-bottom-line">
        <span>روانکاوی</span>
        <span class="bottom-dot" aria-hidden="true"></span>
        <span>فلسفه</span>
        <span class="bottom-spacer"></span>
        <span>مطالعه‌ای در مرز روان و اندیشه</span>
      </div>
    </section>

    <section class="explore" id="explore" aria-labelledby="explore-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-overline" lang="en" dir="ltr">
              TWO FIELDS OF INQUIRY
            </span>
            <h2 id="explore-title">دو مسیر برای فهم جهان و انسان</h2>
          </div>
          <p>دو قلمرو مستقل، با پرسش‌هایی مشترک دربارهٔ تجربه، شناخت و معنای زندگی.</p>
        </div>

        <div class="worlds">
          <section class="world world-psy" aria-labelledby="psy-title">
            <header class="world-header">
              <div>
                <span class="world-number" lang="en" dir="ltr">
                  01 / PSYCHOANALYSIS
                </span>
                <h3 id="psy-title">روانکاوی</h3>
                <p>کاوش در جهان ناپیدای روان</p>
              </div>
              <span class="world-emblem" aria-hidden="true">
                Ψ
              </span>
            </header>

            <p class="world-intro">
              از ناخودآگاه و تعارض‌های درونی تا رابطه، فقدان و شکل‌گیری تجربهٔ انسانی.
            </p>

            <ol class="articles" aria-label="تازه‌ترین مطالب روانکاوی">
              {psychoanalysisArticles.length > 0 ? (
                psychoanalysisArticles.map((article, index) => (
                  <li>
                    <a class="article" href={`/materials/${article.id}/`}>
                      <span class="article-index">{formatIndex(index)}</span>
                      {article.data.cover ? (
                        <img
                          class="article-image"
                          src={article.data.cover}
                          alt=""
                          width="1200"
                          height="650"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="article-image article-placeholder" aria-hidden="true"></span>
                      )}
                      <span class="article-text">
                        <strong>{article.data.title}</strong>
                        <span>{article.data.description}</span>
                      </span>
                      <ArrowLeft
                        class="article-arrow"
                        size={18}
                        stroke-width={1.7}
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))
              ) : (
                <li class="empty-state">مطالب این بخش به‌زودی منتشر خواهند شد.</li>
              )}
            </ol>

            <a class="world-footer" href="/psychoanalysis/">
              <span>ورود به قلمرو روانکاوی</span>
              <ArrowLeft size={18} stroke-width={1.7} aria-hidden="true" />
            </a>
          </section>

          <section class="world world-philo" aria-labelledby="philo-title">
            <header class="world-header">
              <div>
                <span class="world-number" lang="en" dir="ltr">
                  02 / PHILOSOPHY
                </span>
                <h3 id="philo-title">فلسفه</h3>
                <p>اندیشیدن به بنیادهای هستی و شناخت</p>
              </div>
              <span class="world-emblem" aria-hidden="true">
                Φ
              </span>
            </header>

            <p class="world-intro">از حقیقت و آزادی تا هستی، اخلاق و امکان فهم جهان.</p>

            <ol class="articles" aria-label="تازه‌ترین مطالب فلسفه">
              {philosophyArticles.length > 0 ? (
                philosophyArticles.map((article, index) => (
                  <li>
                    <a class="article" href={`/materials/${article.id}/`}>
                      <span class="article-index">{formatIndex(index)}</span>
                      {article.data.cover ? (
                        <img
                          class="article-image"
                          src={article.data.cover}
                          alt=""
                          width="1200"
                          height="650"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="article-image article-placeholder" aria-hidden="true"></span>
                      )}
                      <span class="article-text">
                        <strong>{article.data.title}</strong>
                        <span>{article.data.description}</span>
                      </span>
                      <ArrowLeft
                        class="article-arrow"
                        size={18}
                        stroke-width={1.7}
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))
              ) : (
                <li class="empty-state">مطالب این بخش به‌زودی منتشر خواهند شد.</li>
              )}
            </ol>

            <a class="world-footer" href="/philosophy/">
              <span>ورود به قلمرو فلسفه</span>
              <ArrowLeft size={18} stroke-width={1.7} aria-hidden="true" />
            </a>
          </section>
        </div>
      </div>
    </section>

    <p class="closing-line">
      <span lang="en" dir="ltr">
        THE SEARCH CONTINUES
      </span>
      <span class="closing-mark" aria-hidden="true">
        ✳
      </span>
      <span>جست‌وجو ادامه دارد</span>
    </p>
  </div>
</Layout>

<style>
  .home-page {
    color: var(--sina-charcoal);
  }

  .hero {
    border-block-end: 1px solid var(--sina-border);
    background: var(--sina-white);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(36px, 7vw, 100px);
    padding-block: clamp(48px, 8vw, 104px);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: var(--sina-teal-deep);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .eyebrow-line {
    inline-size: 28px;
    block-size: 2px;
    background: var(--sina-ruby);
  }

  .eyebrow-en {
    margin-inline-start: var(--space-2);
    color: var(--sina-muted);
    font-family: Arial, sans-serif;
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .hero h1 {
    margin: var(--space-8) 0 var(--space-4);
    font-size: var(--text-display);
    line-height: 1.48;
    letter-spacing: -0.045em;
    font-weight: 800;
  }

  .hero h1 > span,
  .hero h1 > em {
    display: block;
  }

  .hero h1 > span {
    color: #3b4648;
  }

  .hero h1 > em {
    width: fit-content;
    color: var(--sina-teal-deep);
    font-style: normal;
    text-decoration: underline;
    text-decoration-color: var(--sina-tint-teal);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.14em;
  }

  .hero-description {
    max-width: 440px;
    margin: 0;
    color: var(--sina-muted);
    font-size: var(--text-lg);
    line-height: 2;
  }

  .hero-link {
    display: inline-flex;
    min-block-size: 48px;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
    color: var(--sina-charcoal);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .link-icon {
    display: grid;
    inline-size: 42px;
    block-size: 42px;
    place-items: center;
    border: 1px solid var(--sina-border);
    color: var(--sina-teal-deep);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .hero-link:hover .link-icon {
    background: var(--sina-teal-deep);
    color: var(--sina-white);
  }

  .hero-index {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-12);
    color: var(--sina-muted);
    font-family: Arial, sans-serif;
    font-size: var(--text-xs);
    letter-spacing: 0.11em;
  }

  .hero-index > span:first-child {
    color: var(--sina-ruby-deep);
    font-size: var(--text-sm);
  }

  .index-rule {
    inline-size: 34px;
    block-size: 1px;
    background: var(--sina-border);
  }

  .art-stage {
    min-width: 0;
    margin: 0;
  }

  .art-stage img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sina-border);
    background: var(--sina-charcoal);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .art-stage figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block-start: var(--space-3);
    color: var(--sina-muted);
    font-size: var(--text-xs);
  }

  .art-stage figcaption span:first-child {
    color: var(--sina-ruby-deep);
    font-family: Arial, sans-serif;
    letter-spacing: 0.08em;
  }

  .hero-bottom-line {
    display: flex;
    min-block-size: 52px;
    align-items: center;
    gap: var(--space-3);
    padding-inline: max(1.5rem, calc((100% - var(--container)) / 2));
    border-block-start: 1px solid var(--sina-border);
    color: var(--sina-muted);
    font-size: var(--text-xs);
  }

  .bottom-dot {
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: var(--sina-ruby);
  }

  .bottom-spacer {
    flex: 1;
  }

  .explore {
    padding-block: clamp(56px, 8vw, 96px);
    background: var(--sina-paper);
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-block-end: var(--space-8);
  }

  .section-overline {
    color: var(--sina-ruby-deep);
    font-family: Arial, sans-serif;
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
  }

  .section-heading h2 {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xl);
    line-height: 1.6;
  }

  .section-heading > p {
    max-width: 390px;
    margin: 0;
    color: var(--sina-muted);
    font-size: var(--text-sm);
    line-height: 2;
  }

  .worlds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 64px);
  }

  .world {
    --accent: var(--sina-teal-deep);
    min-width: 0;
    padding-block-start: var(--space-4);
    border-block-start: 2px solid var(--accent);
  }

  .world-psy {
    --accent: var(--sina-ruby-deep);
  }

  .world-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .world-number {
    color: var(--sina-muted);
    font-family: Arial, sans-serif;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
  }

  .world-header h3 {
    margin: var(--space-2) 0 0;
    color: var(--accent);
    font-size: var(--text-xl);
    line-height: 1.5;
  }

  .world-header p {
    margin: 0;
    color: var(--sina-muted);
    font-size: var(--text-sm);
  }

  .world-emblem {
    display: grid;
    inline-size: 52px;
    block-size: 52px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--sina-border);
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 28px;
  }

  .world-intro {
    margin: var(--space-6) 0 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--sina-border);
    color: var(--sina-muted);
    font-size: var(--text-sm);
    line-height: 2;
  }

  .articles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .articles > li {
    border-block-end: 1px solid var(--sina-border);
  }

  .article {
    display: grid;
    grid-template-columns: 28px 72px minmax(0, 1fr) 20px;
    min-block-size: 92px;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  .article-index {
    align-self: start;
    padding-block-start: var(--space-1);
    color: var(--accent);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .article-image {
    display: block;
    width: 72px;
    height: 58px;
    background: var(--sina-paper);
    object-fit: cover;
  }

  .article-placeholder {
    border: 1px solid var(--sina-border);
  }

  .article-text {
    display: grid;
    min-width: 0;
    gap: var(--space-1);
  }

  .article-text strong {
    color: var(--sina-charcoal);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.8;
  }

  .article-text > span {
    display: -webkit-box;
    overflow: hidden;
    color: var(--sina-muted);
    font-size: var(--text-xs);
    line-height: 1.8;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .article-arrow {
    color: var(--accent);
    transition: transform 160ms ease;
  }

  .empty-state {
    padding-block: var(--space-6);
    color: var(--sina-muted);
    font-size: var(--text-sm);
  }

  .world-footer {
    display: flex;
    min-block-size: 48px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .closing-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-6) var(--space-4);
    color: var(--sina-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .closing-mark {
    color: var(--sina-ruby);
  }

  @media (hover: hover) and (pointer: fine) {
    .article:hover .article-text strong {
      color: var(--accent);
    }

    .article:hover .article-arrow,
    .world-footer:hover svg {
      transform: translateX(-3px);
    }
  }

  @media (max-width: 950px) {
    .hero-layout {
      gap: var(--space-8);
    }

    .article {
      grid-template-columns: 24px 60px minmax(0, 1fr) 18px;
      gap: var(--space-2);
    }

    .article-image {
      width: 60px;
      height: 54px;
    }
  }

  @media (max-width: 760px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .hero-copy {
      max-width: 620px;
    }

    .art-stage {
      width: min(100%, 620px);
      justify-self: center;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
    }

    .worlds {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }

  @media (max-width: 480px) {
    .hero h1 {
      font-size: clamp(2.5rem, 10vw, 3.25rem);
      line-height: 1.55;
    }

    .hero-description {
      font-size: var(--text-base);
    }

    .hero-index {
      margin-block-start: var(--space-8);
      font-size: 0.6875rem;
    }

    .hero-bottom-line {
      min-block-size: 48px;
      padding-inline: 1rem;
    }

    .hero-bottom-line > span:last-child {
      font-size: var(--text-xs);
    }

    .article {
      grid-template-columns: 24px 56px minmax(0, 1fr) 18px;
    }

    .article-image {
      width: 56px;
      height: 50px;
    }

    .article-text strong {
      font-size: var(--text-xs);
    }

    .article-text > span {
      font-size: 0.6875rem;
    }

    .closing-line {
      gap: var(--space-2);
      letter-spacing: 0;
    }
  }
</style>
