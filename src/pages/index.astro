---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const materials = await getCollection(
  'content',
  ({ data }) => !data.draft
);

function latestIn(section: string) {
  return materials
    .filter((entry) => entry.data.section === section)
    .sort((a, b) => {
      const dateA = a.data.publishedAt ? Date.parse(a.data.publishedAt) : 0;
      const dateB = b.data.publishedAt ? Date.parse(b.data.publishedAt) : 0;
      return dateB - dateA || b.id.localeCompare(a.id);
    })
    .slice(0, 3);
}

const psychoanalysisArticles = latestIn('psychoanalysis');
const philosophyArticles = latestIn('philosophy');
---

<Layout
  title="روانکاوی و فلسفه | سینا یعقوبی"
  description="فضایی برای مطالعه و تأمل در روانکاوی و فلسفه."
>
  <main class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grain"></div>
      <div class="hero-orbit orbit-one"></div>
      <div class="hero-orbit orbit-two"></div>

      <div class="container hero-layout">
        <div class="hero-copy">
          <div class="eyebrow">
            <span class="eyebrow-line"></span>
            <span>روانکاوی و فلسفه</span>
            <span class="eyebrow-en">PSYCHE & THOUGHT</span>
          </div>

          <h1 id="hero-title">
            در جست‌وجوی
            <span class="title-line">معنای آنچه</span>
            <span class="title-accent">پنهان است.</span>
          </h1>

          <p class="hero-description">
            تأملی در روان، اندیشه و پیچیدگی تجربهٔ انسانی.
          </p>

          <a href="#explore" class="hero-link">
            <span class="link-circle">↓</span>
            <span>ورود به جهان اندیشه</span>
          </a>

          <div class="hero-index">
            <span>01</span>
            <span class="index-rule"></span>
            <span>AN INQUIRY INTO THE HUMAN CONDITION</span>
          </div>
        </div>

        <div class="art-stage" aria-label="ترکیبی انتزاعی از آینه، حجم‌های شیشه‌ای و معماری">
          <div class="art-backdrop"></div>
          <div class="art-halo"></div>

          <div class="art-architecture">
            <div class="arch-wall wall-left"></div>
            <div class="arch-wall wall-right"></div>
            <div class="arch-floor"></div>
            <div class="arch-opening"></div>
            <div class="arch-stairs">
              <i></i><i></i><i></i><i></i><i></i><i></i>
            </div>
          </div>

          <div class="glass-disc disc-back"></div>
          <div class="glass-disc disc-front"></div>

          <div class="glass-object">
            <div class="glass-object-inner"></div>
            <div class="glass-reflection"></div>
          </div>

          <div class="floating-sphere sphere-one"></div>
          <div class="floating-sphere sphere-two"></div>
          <div class="floating-sphere sphere-three"></div>

          <div class="art-book">
            <div class="book-cover"></div>
            <div class="book-pages"></div>
            <div class="book-shadow"></div>
          </div>

          <div class="art-coordinate coordinate-top">
            <span>FIG. 01</span>
            <span>THE INNER LANDSCAPE</span>
          </div>

          <div class="art-coordinate coordinate-bottom">
            <span class="coordinate-dot"></span>
            <span>لایه‌های پنهان تجربه</span>
            <span class="coordinate-divider"></span>
            <span>ذهن · معنا · هستی</span>
          </div>

          <div class="art-vertical-label">BEYOND THE VISIBLE</div>
        </div>
      </div>

      <div class="hero-bottom-line">
        <span>روانکاوی</span>
        <span class="bottom-dot"></span>
        <span>فلسفه</span>
        <span class="bottom-spacer"></span>
        <span>مطالعه‌ای در مرز روان و اندیشه</span>
      </div>
    </section>

    <section class="explore" id="explore">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-overline">TWO FIELDS OF INQUIRY</span>
            <h2>دو مسیر برای فهم جهان و انسان</h2>
          </div>
          <p>
            دو قلمرو مستقل، با پرسش‌هایی مشترک درباره تجربه، شناخت و معنای زندگی.
          </p>
        </div>

        <div class="worlds">
          <section class="world world-psy" aria-labelledby="psy-title">
            <div class="world-atmosphere"></div>
            <div class="world-decoration">
              <span class="deco-ring ring-a"></span>
              <span class="deco-ring ring-b"></span>
              <span class="deco-orb"></span>
            </div>

            <div class="world-content">
              <header class="world-header">
                <div>
                  <span class="world-number">01 / PSYCHOANALYSIS</span>
                  <h3 id="psy-title">روانکاوی</h3>
                  <p>کاوش در جهان ناپیدای روان</p>
                </div>
                <div class="world-emblem" aria-hidden="true">
                  <span>Ψ</span>
                </div>
              </header>

              <div class="world-intro">
                از ناخودآگاه و تعارض‌های درونی تا رابطه، فقدان و شکل‌گیری تجربه انسانی.
              </div>

              <div class="articles">
                {psychoanalysisArticles.length > 0 ? (
                  psychoanalysisArticles.map((article, index) => (
                    <a class="article" href={`/materials/${article.id}/`}>
                      <span class="article-index">۰{index + 1}</span>
                      {article.data.cover ? (
                        <img
                          class="article-image"
                          src={article.data.cover}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="article-image article-placeholder"></span>
                      )}
                      <span class="article-text">
                        <strong>{article.data.title}</strong>
                        <span>{article.data.description}</span>
                      </span>
                      <span class="article-arrow">↙</span>
                    </a>
                  ))
                ) : (
                  <p class="empty-state">مطالب این بخش به‌زودی منتشر خواهند شد.</p>
                )}
              </div>

              <a class="world-footer" href="/psychoanalysis/">
                <span>ورود به قلمرو روانکاوی</span>
                <span class="footer-arrow">←</span>
              </a>
            </div>
          </section>

          <section class="world world-philo" aria-labelledby="philo-title">
            <div class="world-atmosphere"></div>
            <div class="world-decoration">
              <span class="deco-ring ring-a"></span>
              <span class="deco-ring ring-b"></span>
              <span class="deco-orb"></span>
            </div>

            <div class="world-content">
              <header class="world-header">
                <div>
                  <span class="world-number">02 / PHILOSOPHY</span>
                  <h3 id="philo-title">فلسفه</h3>
                  <p>اندیشیدن به بنیادهای هستی و شناخت</p>
                </div>
                <div class="world-emblem" aria-hidden="true">
                  <span>Φ</span>
                </div>
              </header>

              <div class="world-intro">
                از حقیقت و آزادی تا هستی، اخلاق و امکان فهم جهان.
              </div>

              <div class="articles">
                {philosophyArticles.length > 0 ? (
                  philosophyArticles.map((article, index) => (
                    <a class="article" href={`/materials/${article.id}/`}>
                      <span class="article-index">۰{index + 1}</span>
                      {article.data.cover ? (
                        <img
                          class="article-image"
                          src={article.data.cover}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="article-image article-placeholder"></span>
                      )}
                      <span class="article-text">
                        <strong>{article.data.title}</strong>
                        <span>{article.data.description}</span>
                      </span>
                      <span class="article-arrow">↙</span>
                    </a>
                  ))
                ) : (
                  <p class="empty-state">مطالب این بخش به‌زودی منتشر خواهند شد.</p>
                )}
              </div>

              <a class="world-footer" href="/philosophy/">
                <span>ورود به قلمرو فلسفه</span>
                <span class="footer-arrow">←</span>
              </a>
            </div>
          </section>
        </div>
      </div>
    </section>

    <div class="closing-line">
      <span>THE SEARCH CONTINUES</span>
      <span class="closing-mark">✳</span>
      <span>جست‌وجو ادامه دارد</span>
    </div>
  </main>
</Layout>

<style>
  :global(:root) {
    --home-ink: #252B32;
    --home-muted: #747C82;
    --home-paper: #F7F8F6;
    --home-teal: #007F80;
    --home-teal-bright: #19AAA2;
    --home-ruby: #8F1946;
    --home-ruby-bright: #BD3C68;
  }

  .home-page {
    overflow: hidden;
    background: var(--home-paper);
    color: var(--home-ink);
  }

  .container {
    width: min(1180px, calc(100% - 64px));
    margin-inline: auto;
  }

  .hero {
    position: relative;
    isolation: isolate;
    min-height: 690px;
    padding: 76px 0 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 78% 44%, rgba(0, 127, 128, .11), transparent 38%),
      radial-gradient(ellipse at 12% 80%, rgba(165, 31, 82, .055), transparent 35%),
      linear-gradient(118deg, #fff 0%, #f7faf8 48%, #eef3f0 100%);
  }

  .hero-grain {
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: .18;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
  }

  .hero-orbit {
    position: absolute;
    z-index: -1;
    border: 1px solid rgba(0, 127, 128, .09);
    border-radius: 50%;
    pointer-events: none;
  }

  .orbit-one {
    width: 660px;
    height: 660px;
    top: -260px;
    right: -170px;
  }

  .orbit-two {
    width: 500px;
    height: 500px;
    top: -180px;
    right: -90px;
    border-color: rgba(165, 31, 82, .08);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: .91fr 1.09fr;
    align-items: center;
    gap: 54px;
    min-height: 550px;
    padding-bottom: 65px;
  }

  .hero-copy {
    position: relative;
    z-index: 3;
    padding: 15px 0;
    animation: reveal-up .9s both;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--home-teal);
    font-size: 12px;
    font-weight: 700;
  }

  .eyebrow-line {
    width: 30px;
    height: 1px;
    background: var(--home-ruby);
  }

  .eyebrow-en {
    margin-right: 3px;
    color: #929b98;
    font-family: Arial, sans-serif;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: .16em;
    direction: ltr;
  }

  .hero h1 {
    margin: 30px 0 20px;
    font-size: clamp(43px, 5.1vw, 68px);
    line-height: 1.55;
    letter-spacing: -.055em;
    font-weight: 800;
  }

  .hero h1 > span { display: block; }
  .title-line { color: #3b4648; }

  .title-accent {
    position: relative;
    width: fit-content;
    color: var(--home-teal);
  }

  .title-accent::after {
    position: absolute;
    right: 4px;
    bottom: 2px;
    width: 65%;
    height: 5px;
    background: linear-gradient(90deg, transparent, rgba(0, 159, 154, .32));
    content: "";
  }

  .hero-description {
    max-width: 400px;
    margin: 0;
    color: #737d7d;
    font-size: 16px;
    line-height: 2.3;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    margin-top: 34px;
    color: #465454;
    font-size: 12px;
    font-weight: 700;
    transition: color .25s ease;
  }

  .link-circle {
    display: grid;
    place-items: center;
    width: 39px;
    height: 39px;
    border: 1px solid rgba(0, 127, 128, .35);
    border-radius: 50%;
    background: rgba(255, 255, 255, .6);
    color: var(--home-teal);
    font-size: 18px;
    transition: all .3s ease;
  }

  .hero-link:hover { color: var(--home-teal); }
  .hero-link:hover .link-circle {
    transform: translateY(4px);
    background: var(--home-teal);
    color: white;
  }

  .hero-index {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 65px;
    color: #929b98;
    font-family: Arial, sans-serif;
    font-size: 8px;
    letter-spacing: .13em;
    direction: ltr;
  }

  .hero-index > span:first-child { color: var(--home-ruby); font-size: 11px; }
  .index-rule { width: 38px; height: 1px; background: rgba(37, 43, 50, .2); }

  .art-stage {
    position: relative;
    isolation: isolate;
    min-width: 0;
    aspect-ratio: 1.12;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .85);
    border-radius: 4px 100px 4px 4px;
    background:
      radial-gradient(ellipse at 55% 43%, rgba(104, 180, 162, .28), transparent 37%),
      linear-gradient(145deg, #263e3e, #142829 65%, #1c3435);
    box-shadow: 0 35px 85px rgba(25, 52, 48, .22), 0 10px 25px rgba(37, 43, 50, .1), inset 0 1px rgba(255, 255, 255, .35);
    animation: art-appear 1.1s .15s both;
  }

  .art-stage::before {
    position: absolute;
    z-index: 8;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, .18);
    background: linear-gradient(125deg, rgba(255, 255, 255, .15), transparent 28%), linear-gradient(0deg, rgba(9, 24, 26, .35), transparent 45%);
    content: "";
    pointer-events: none;
  }

  .art-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 48%, transparent 0 25%, rgba(5, 20, 22, .25) 75%), linear-gradient(130deg, #294746, #172e30);
  }

  .art-halo {
    position: absolute;
    top: 14%;
    left: 27%;
    width: 50%;
    aspect-ratio: 1;
    border: 1px solid rgba(213, 235, 218, .34);
    border-radius: 50%;
    box-shadow: 0 0 0 18px rgba(213, 235, 218, .025), 0 0 70px rgba(147, 214, 189, .13), inset 0 0 45px rgba(147, 214, 189, .12);
  }

  .art-architecture { position: absolute; inset: 12% 12% 9%; perspective: 800px; }
  .arch-wall {
    position: absolute;
    top: 12%;
    height: 69%;
    border: 1px solid rgba(220, 234, 219, .2);
    background: linear-gradient(135deg, rgba(206, 227, 208, .1), rgba(255, 255, 255, .015));
    box-shadow: inset 0 0 35px rgba(255, 255, 255, .035);
  }
  .wall-left { left: 9%; width: 30%; transform: skewY(-13deg); }
  .wall-right { right: 9%; width: 30%; transform: skewY(13deg); }

  .arch-opening {
    position: absolute;
    top: 18%;
    left: 34%;
    width: 32%;
    height: 52%;
    border: 1px solid rgba(218, 237, 222, .5);
    border-bottom: 0;
    border-radius: 50% 50% 0 0 / 23% 23% 0 0;
    box-shadow: 0 0 30px rgba(161, 215, 190, .12), inset 0 0 28px rgba(161, 215, 190, .08);
  }
  .arch-opening::after {
    position: absolute;
    inset: 12px 12px 0;
    border: 1px solid rgba(218, 237, 222, .2);
    border-bottom: 0;
    border-radius: inherit;
    content: "";
  }

  .arch-floor {
    position: absolute;
    bottom: 4%;
    left: 5%;
    width: 90%;
    height: 30%;
    transform: rotateX(62deg);
    background: repeating-linear-gradient(90deg, transparent 0 39px, rgba(215, 233, 220, .11) 40px, transparent 41px);
    border-top: 1px solid rgba(215, 233, 220, .22);
  }

  .arch-stairs { position: absolute; right: 16%; bottom: 8%; width: 38%; height: 35%; transform: skewY(-25deg); }
  .arch-stairs i {
    position: absolute;
    right: 0;
    width: 100%;
    height: 7px;
    border: 1px solid rgba(224, 237, 224, .32);
    background: linear-gradient(90deg, rgba(194, 224, 207, .2), rgba(255, 255, 255, .04));
    box-shadow: 0 6px 12px rgba(0, 0, 0, .1);
  }
  .arch-stairs i:nth-child(1) { bottom: 0; width: 48%; }
  .arch-stairs i:nth-child(2) { bottom: 17px; width: 57%; }
  .arch-stairs i:nth-child(3) { bottom: 34px; width: 66%; }
  .arch-stairs i:nth-child(4) { bottom: 51px; width: 75%; }
  .arch-stairs i:nth-child(5) { bottom: 68px; width: 84%; }
  .arch-stairs i:nth-child(6) { bottom: 85px; width: 93%; }

  .glass-disc {
    position: absolute;
    z-index: 3;
    top: 23%;
    left: 35%;
    width: 34%;
    aspect-ratio: 1;
    border: 1px solid rgba(228, 247, 232, .52);
    border-radius: 50%;
    background: radial-gradient(circle at 33% 28%, rgba(255, 255, 255, .5), transparent 18%), radial-gradient(circle at 65% 72%, rgba(68, 172, 154, .22), transparent 43%), linear-gradient(140deg, rgba(228, 248, 236, .16), rgba(255, 255, 255, .015));
    box-shadow: inset -12px -12px 30px rgba(0, 0, 0, .14), inset 8px 8px 20px rgba(255, 255, 255, .18), 0 0 40px rgba(174, 226, 201, .12);
    backdrop-filter: blur(4px);
  }
  .disc-back { top: 18%; left: 42%; width: 30%; opacity: .42; transform: scale(.85); }
  .disc-front { transform: translate(-22%, 23%) scale(.72); opacity: .55; }

  .glass-object {
    position: absolute;
    z-index: 5;
    top: 29%;
    left: 40%;
    width: 24%;
    aspect-ratio: .8;
    transform: rotate(28deg) skewY(-8deg);
    border: 1px solid rgba(244, 255, 244, .58);
    border-radius: 46% 54% 42% 58% / 35% 38% 62% 65%;
    background: linear-gradient(135deg, rgba(255, 255, 255, .48), transparent 24%), linear-gradient(145deg, rgba(160, 223, 199, .22), rgba(255, 255, 255, .035) 55%, rgba(23, 87, 83, .26));
    box-shadow: inset 8px 5px 15px rgba(255, 255, 255, .24), inset -9px -12px 25px rgba(0, 0, 0, .19), 0 20px 35px rgba(0, 0, 0, .2);
    backdrop-filter: blur(5px);
    animation: object-float 9s ease-in-out infinite alternate;
  }
  .glass-object-inner { position: absolute; inset: 20%; border: 1px solid rgba(255, 255, 255, .28); border-radius: 50%; transform: rotate(-30deg); }
  .glass-reflection { position: absolute; top: 12%; left: 18%; width: 20%; height: 38%; border-radius: 50%; background: rgba(255, 255, 255, .55); filter: blur(5px); }

  .floating-sphere {
    position: absolute;
    z-index: 6;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #fff, #9bcfc0 18%, #477e77 55%, #173c3a 100%);
    box-shadow: 0 15px 25px rgba(0, 0, 0, .25), inset 2px 2px 5px rgba(255, 255, 255, .6);
  }
  .sphere-one { top: 21%; right: 19%; width: 25px; height: 25px; }
  .sphere-two { bottom: 23%; left: 18%; width: 13px; height: 13px; opacity: .8; }
  .sphere-three { top: 61%; right: 16%; width: 9px; height: 9px; background: radial-gradient(circle at 30% 25%, #fff, #d77b9c 30%, #812b4e 100%); }

  .art-book { position: absolute; z-index: 7; bottom: 14%; left: 19%; width: 30%; height: 13%; transform: rotate(-13deg) skewY(4deg); filter: drop-shadow(0 15px 12px rgba(0, 0, 0, .3)); }
  .book-cover { position: absolute; inset: 0; border: 1px solid rgba(244, 229, 198, .5); background: linear-gradient(145deg, #a77c57, #5c3e32); transform: skewY(-8deg); }
  .book-pages { position: absolute; top: -7px; left: 5px; width: 95%; height: 75%; background: repeating-linear-gradient(0deg, #eee1c9 0 2px, #d6c6a9 3px 4px); transform: skewY(8deg); border-radius: 2px; }
  .book-shadow { position: absolute; right: 0; bottom: -8px; width: 85%; height: 8px; background: #2b2925; transform: skewX(-45deg); }

  .art-coordinate { position: absolute; z-index: 9; display: flex; align-items: center; gap: 11px; color: rgba(244, 246, 235, .75); font-family: Arial, sans-serif; font-size: 8px; letter-spacing: .16em; direction: ltr; }
  .coordinate-top { top: 24px; left: 26px; }
  .coordinate-bottom { right: 22px; bottom: 22px; padding: 12px 15px; border: 1px solid rgba(255, 255, 255, .2); border-radius: 2px; background: rgba(20, 44, 43, .5); backdrop-filter: blur(15px); font-family: inherit; font-size: 9px; letter-spacing: 0; }
  .coordinate-dot { width: 6px; height: 6px; border-radius: 50%; background: #d45c85; box-shadow: 0 0 10px #d45c85; }
  .coordinate-divider { width: 1px; height: 13px; background: rgba(255, 255, 255, .35); }
  .art-vertical-label { position: absolute; z-index: 9; top: 50%; right: 13px; color: rgba(255, 255, 255, .42); font-family: Arial, sans-serif; font-size: 7px; letter-spacing: .18em; writing-mode: vertical-rl; transform: translateY(-50%); }

  .hero-bottom-line { display: flex; align-items: center; gap: 13px; min-height: 57px; padding-inline: max(32px, calc((100% - 1180px) / 2)); border-top: 1px solid rgba(37, 43, 50, .09); color: #697572; font-size: 10px; }
  .bottom-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--home-ruby); }
  .bottom-spacer { flex: 1; }

  .explore { position: relative; padding: 88px 0 76px; background: radial-gradient(ellipse at 50% 0%, rgba(0, 127, 128, .035), transparent 50%), #f7f8f6; scroll-margin-top: 80px; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 35px; margin-bottom: 34px; }
  .section-overline { color: var(--home-ruby); font-family: Arial, sans-serif; font-size: 9px; letter-spacing: .19em; }
  .section-heading h2 { margin: 12px 0 0; font-size: clamp(23px, 3vw, 34px); font-weight: 800; letter-spacing: -.04em; }
  .section-heading > p { max-width: 300px; margin: 0 0 5px; color: var(--home-muted); font-size: 12px; line-height: 2.2; }
