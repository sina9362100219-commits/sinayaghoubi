---
import { getCollection } from 'astro:content';
import { ArrowDown } from '@lucide/astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import MainGridLayout from '../components/MainGridLayout.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../config';

const materials = await getCollection('content', ({ data }) => !data.draft);
materials.sort(
  (a, b) =>
    (b.data.publishedAt ?? '').localeCompare(a.data.publishedAt ?? '') || b.id.localeCompare(a.id),
);
const revealTypes = ['diagonal', 'circle', 'curtain'] as const;
---

<MainGridLayout
  title={`${siteConfig.introduction} | ${siteConfig.title}`}
  description="فضایی برای مطالعه و تأمل در روانکاوی، فلسفه و تجربهٔ انسانی."
  socialImage="/images/abyss.jpg"
  socialImageAlt="تصویری از زنی در کنار چراغی گرم‌رنگ"
  isHome={true}
>
  <section class="home-hero" aria-labelledby="home-title" data-parallax-section>
    <div class="home-hero-backdrop" aria-hidden="true" data-parallax></div>
    <img
      class="home-hero-image"
      src="/images/abyss.jpg"
      alt=""
      width="977"
      height="1303"
      fetchpriority="high"
      decoding="async"
    />
    <div class="home-hero-shade"></div>
    <div class="home-hero-content">
      <span class="home-hero-brand">{siteConfig.title}</span>
      <blockquote class="home-hero-quote">
        <h1 id="home-title">
          «دور بودم، بسیار دورتر از آنچه فکر می‌کردی؛ و دست تکان نمی‌دادم، بلکه داشتم غرق می‌شدم.»
        </h1>
        <footer class="home-hero-attribution" dir="ltr">
          — Stevie Smith<br />
          <cite>“Not Waving but Drowning”</cite>
        </footer>
      </blockquote>
    </div>
    <a class="hero-scroll" href="#latest-title">
      <span>ادامهٔ مطالعه</span>
      <ArrowDown size={16} aria-hidden="true" />
    </a>
  </section>

  <FeaturedCarousel entries={materials} />

  <div class="editorial-divider" aria-hidden="true"></div>

  <section class="latest-section" aria-labelledby="latest-title">
    <header class="feed-heading">
      <div>
        <span class="eyebrow">SINA YAGHOUB</span>
        <h2 id="latest-title" data-word-reveal>
          نوشته‌ها
        </h2>
        <p>روانکاوی و فلسفه؛ برای خواندن و بازاندیشیدن.</p>
      </div>
      <a class="read-link" href="/archive/">
        آرشیو کامل <span aria-hidden="true">←</span>
      </a>
    </header>

    <CategoryFilter />

    {materials.length > 0 ? (
      <div class="post-list" id="latest-grid" data-filter-grid aria-label="فهرست نوشته‌ها">
        {materials.map((entry, index) => (
          <PostCard
            entry={entry}
            featured={index === 0}
            index={index}
            revealType={revealTypes[index % revealTypes.length]}
          />
        ))}
      </div>
    ) : (
      <p class="archive-empty">نوشته‌ای برای نمایش وجود ندارد.</p>
    )}
  </section>
</MainGridLayout>

<script>
  const heroImage = document.querySelector<HTMLElement>('[data-parallax]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let parallaxFrame = 0;

  function updateParallax() {
    if (!heroImage || reducedMotion.matches || parallaxFrame) return;
    parallaxFrame = window.requestAnimationFrame(() => {
      const heroTop = heroImage.getBoundingClientRect().top + window.scrollY;
      const offset = Math.min(64, Math.max(-12, (window.scrollY - heroTop) * 0.18));
      heroImage.style.transform = `translate3d(0, ${offset}px, 0) scale(1.08)`;
      parallaxFrame = 0;
    });
  }

  window.addEventListener('scroll', updateParallax, { passive: true });
  window.addEventListener('resize', updateParallax);
</script>
