---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="صفحه پیدا نشد | روانکاوی با سینا"
  description="صفحهٔ درخواستی پیدا نشد."
  noIndex={true}
>
  <section class="not-found container" aria-labelledby="not-found-title">
    <p class="not-found-index" lang="en" dir="ltr">
      404 / NOT FOUND
    </p>
    <h1 id="not-found-title">این صفحه در اینجا نیست.</h1>
    <p>نشانی را بررسی کنید یا از یکی از مسیرهای زیر به مطالعه بازگردید.</p>
    <nav aria-label="مسیرهای پیشنهادی">
      <a href="/">صفحهٔ اصلی</a>
      <a href="/psychoanalysis/">روانکاوی</a>
      <a href="/philosophy/">فلسفه</a>
    </nav>
  </section>
</Layout>

<style>
  .not-found {
    display: grid;
    min-block-size: 58vh;
    align-content: center;
    justify-items: start;
    padding-block: var(--space-16);
  }

  .not-found-index {
    margin: 0;
    color: var(--sina-ruby-deep);
    font-family: Arial, sans-serif;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
  }

  .not-found h1 {
    margin: var(--space-3) 0;
    font-size: var(--text-xl);
    line-height: 1.6;
  }

  .not-found > p:not(.not-found-index) {
    max-width: 560px;
    margin: 0;
    color: var(--sina-muted);
  }

  .not-found nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-block-start: var(--space-6);
  }

  .not-found nav a {
    display: inline-flex;
    min-block-size: 44px;
    align-items: center;
    color: var(--sina-teal-deep);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
