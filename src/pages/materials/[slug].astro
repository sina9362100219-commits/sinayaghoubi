---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowDown } from '@lucide/astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import MainGridLayout from '../../components/MainGridLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TOC from '../../components/TOC.astro';
import { siteConfig } from '../../config';
import { estimateReadingMinutes } from '../../lib/reading-time';

export async function getStaticPaths() {
  const entries = await getCollection('content', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sectionTitle = entry.data.section === 'psychoanalysis' ? 'روانکاوی' : 'فلسفه';
const sectionUrl = entry.data.section === 'psychoanalysis' ? '/psychoanalysis/' : '/philosophy/';
const readingMinutes = estimateReadingMinutes(entry.body ?? '');
const allEntries = await getCollection('content', ({ data }) => !data.draft);
const relatedEntries = allEntries
  .filter((candidate) => candidate.id !== entry.id)
  .map((candidate, index) => ({
    candidate,
    index,
    score:
      (candidate.data.section === entry.data.section ? 2 : 0) +
      candidate.data.tags.filter((tag) => entry.data.tags.includes(tag)).length,
  }))
  .sort(
    (a, b) =>
      b.score - a.score ||
      (b.candidate.data.publishedAt ?? '').localeCompare(a.candidate.data.publishedAt ?? '') ||
      a.index - b.index,
  )
  .slice(0, 3)
  .map(({ candidate }) => candidate);
const revealTypes = ['diagonal', 'circle', 'curtain'] as const;
---

<MainGridLayout
  title={`${entry.data.title} | سینا یعقوبی`}
  description={entry.data.description}
  type="article"
  socialImage={entry.data.cover}
  socialImageAlt={entry.data.coverAlt}
>
  <div class="article-experience">
    <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

    <section class="article-hero" aria-labelledby="article-title" data-article-parallax>
      {entry.data.cover ? (
        <button
          class="article-hero-open"
          type="button"
          aria-label={`بزرگ‌نمایی تصویر: ${entry.data.coverAlt ?? entry.data.title}`}
          aria-haspopup="dialog"
          data-lightbox-open
        >
          <img
            src={entry.data.cover}
            alt=""
            width="1800"
            height="1100"
            fetchpriority="high"
            decoding="async"
            data-article-hero-image
          />
        </button>
      ) : (
        <img
          class="article-hero-fallback"
          src={siteConfig.banner}
          alt=""
          width="1800"
          height="1100"
          fetchpriority="high"
          decoding="async"
          data-article-hero-image
        />
      )}
      <div class="article-hero-shade"></div>
      <div class="article-hero-copy">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
          <a href="/">خانه</a>
          <span aria-hidden="true">/</span>
          <a href={sectionUrl}>{sectionTitle}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{entry.data.title}</span>
        </nav>
        <div class="article-meta">
          <a class="post-section" data-section={entry.data.section} href={sectionUrl}>
            {sectionTitle}
          </a>
          {entry.data.publishedAt && (
            <time datetime={entry.data.publishedAt}>{entry.data.publishedAt}</time>
          )}
          <span>{readingMinutes} دقیقه مطالعه</span>
        </div>
        <h1 id="article-title" data-word-reveal>
          {entry.data.title}
        </h1>
      </div>
      <a class="hero-scroll" href="#article-reading">
        <span>رفتن به متن</span>
        <ArrowDown size={16} aria-hidden="true" />
      </a>
    </section>

    {entry.data.cover && (
      <ImageLightbox src={entry.data.cover} alt={entry.data.coverAlt ?? entry.data.title} />
    )}

    <div class="article-layout" id="article-reading">
      <article class="article-panel">
        <blockquote class="article-pullquote" data-quote-reveal data-pagefind-ignore>
          <span>{entry.data.description}</span>
        </blockquote>

        <div class="article-body" data-pagefind-body>
          <Content />
        </div>

        {entry.data.tags.length > 0 && (
          <div class="article-tags" aria-label="کلیدواژه‌های مطلب">
            {entry.data.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        )}

        <footer class="article-end">
          <span>پایان مطلب</span>
          <a href={sectionUrl}>بازگشت به بخش {sectionTitle}</a>
        </footer>
      </article>
      <TOC headings={headings} />
    </div>

    {relatedEntries.length > 0 && (
      <section class="related-section" aria-labelledby="related-title">
        <header class="feed-heading">
          <div>
            <span class="eyebrow">برای ادامهٔ مطالعه</span>
            <h2 id="related-title" data-word-reveal>
              نوشته‌های مرتبط
            </h2>
          </div>
          <a class="read-link" href={sectionUrl}>
            همهٔ نوشته‌های بخش <ArrowLeft size={15} aria-hidden="true" />
          </a>
        </header>
        <div class="post-list related-grid">
          {relatedEntries.map((relatedEntry, index) => (
            <PostCard
              entry={relatedEntry}
              index={index}
              revealType={revealTypes[index % revealTypes.length]}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</MainGridLayout>

<script>
  const heroImage = document.querySelector<HTMLElement>('[data-article-hero-image]');
  const progressBar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let parallaxFrame = 0;
  let progressFrame = 0;

  function updateParallax() {
    if (!heroImage || reduceMotion.matches || parallaxFrame) return;
    parallaxFrame = window.requestAnimationFrame(() => {
      const top = heroImage.getBoundingClientRect().top + window.scrollY;
      const offset = Math.min(42, Math.max(-12, (window.scrollY - top) * 0.16));
      heroImage.style.transform = `translate3d(0, ${offset}px, 0) scale(1.08)`;
      parallaxFrame = 0;
    });
  }

  function updateProgress() {
    if (!progressBar || progressFrame) return;
    progressFrame = window.requestAnimationFrame(() => {
      const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress =
        scrollableHeight > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollableHeight)) : 1;
      progressBar.style.transform = `scaleX(${progress})`;
      progressFrame = 0;
    });
  }

  window.addEventListener('scroll', updateParallax, { passive: true });
  window.addEventListener('resize', updateParallax);
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();
</script>
