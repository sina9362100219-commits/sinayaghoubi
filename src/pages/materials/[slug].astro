---
import { getCollection, render } from 'astro:content';
import MainGridLayout from '../../components/MainGridLayout.astro';
import TOC from '../../components/TOC.astro';
import { estimateReadingMinutes } from '../../lib/reading-time';

export async function getStaticPaths() {
  const entries = await getCollection('content', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sectionTitle = entry.data.section === 'psychoanalysis' ? 'روانکاوی' : 'فلسفه';
const sectionUrl = entry.data.section === 'psychoanalysis' ? '/psychoanalysis/' : '/philosophy/';
const readingMinutes = estimateReadingMinutes(entry.body ?? '');
---

<MainGridLayout
  title={`${entry.data.title} | روانکاوی با سینا`}
  description={entry.data.description}
  type="article"
  socialImage={entry.data.cover}
  socialImageAlt={entry.data.coverAlt}
>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <div class="article-layout">
    <article class="article-panel">
      <nav class="article-breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a>
        <span aria-hidden="true">/</span>
        <a href={sectionUrl}>{sectionTitle}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{entry.data.title}</span>
      </nav>

      <header class="article-heading">
        <div class="article-meta">
          <a class="post-section" data-section={entry.data.section} href={sectionUrl}>
            {sectionTitle}
          </a>
          {entry.data.publishedAt && (
            <time datetime={entry.data.publishedAt}>{entry.data.publishedAt}</time>
          )}
          <span>{readingMinutes} دقیقه مطالعه</span>
        </div>
        <h1 data-pagefind-meta="title">{entry.data.title}</h1>
        <p class="article-lead">{entry.data.description}</p>
      </header>

      {entry.data.cover && (
        <figure class="article-cover image-reveal" data-article-reveal>
          <img
            src={entry.data.cover}
            alt={entry.data.coverAlt ?? ''}
            width="1200"
            height="650"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      <div class="article-body" data-pagefind-body>
        <Content />
      </div>

      {entry.data.tags.length > 0 && (
        <div class="article-tags" aria-label="کلیدواژه‌های مطلب">
          {entry.data.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      )}

      <footer class="article-end">
        <span>پایان مطلب</span>
        <a href={sectionUrl}>بازگشت به بخش {sectionTitle}</a>
      </footer>
    </article>
    <TOC headings={headings} />
  </div>
</MainGridLayout>

<script>
  const progressBar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const articleBody = document.querySelector<HTMLElement>('[data-pagefind-body]');
  const articleCover = document.querySelector<HTMLElement>('[data-article-reveal]');

  if (articleCover) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || !('IntersectionObserver' in window)) {
      articleCover.classList.add('is-visible');
    } else {
      articleCover.classList.add('is-pending');
      const coverObserver = new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          articleCover.classList.add('is-visible');
          observer.disconnect();
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      coverObserver.observe(articleCover);
    }
  }

  function updateReadingProgress() {
    if (!progressBar || !articleBody) return;
    const articleTop = articleBody.getBoundingClientRect().top + window.scrollY;
    const articleBottom = articleTop + articleBody.offsetHeight - window.innerHeight;
    const progress =
      articleBottom > articleTop
        ? Math.min(
            100,
            Math.max(0, ((window.scrollY - articleTop) / (articleBottom - articleTop)) * 100),
          )
        : 100;
    progressBar.style.width = `${progress}%`;
  }

  window.addEventListener('scroll', updateReadingProgress, { passive: true });
  window.addEventListener('resize', updateReadingProgress);
  updateReadingProgress();
</script>
