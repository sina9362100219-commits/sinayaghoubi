{
  "name": "sinayaghoubi-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{astro,ts,js,md,css}\" \"tests/**/*.{ts,js}\" \"docs/**/*.md\" \"*.{json,mjs,js,cjs,md}\"",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate": "npm run check && npm run lint && npm run format:check && npm run test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@lucide/astro": "^1.72.0",
    "astro": "^7.4.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "^13.6.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
